{
  "expo": {
    "name": "RSVP DXB",
    "slug": "rsvp",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0c15257e-693b-4d40-a8cc-3d49b55cc9bd"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rsvpdxb.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile picture for your RSVP DXB account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rsvpdxb.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4B2A10"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4B2A10"
        }
      ],
      "expo-font",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "0c15257e-693b-4d40-a8cc-3d49b55cc9bd"
      }
    }
  }
}
